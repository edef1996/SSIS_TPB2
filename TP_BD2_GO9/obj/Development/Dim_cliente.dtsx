                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
c.CUSTOMER_ID, 
c.FULL_NAME, 
c.BIRTH_DATE AS BIRTH_DATE_ORIGINAL, 
            TRY_PARSE(
                    REPLACE(
                          REPLACE(c.BIRTH_DATE,'*',''),'j','')AS DATE USING 'en-US') 

AS BIRTH_DATE,
c.CITY, 
c.STATE, 
c.ZIPCODE
FROM [dbo].[stg_clientes_r_G09] c</property>
